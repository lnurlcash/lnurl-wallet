{
  "name": "lnurl-wallet",
  "private": true,
  "packageManager": "npm@12.0.2",
  "description": "LNURLwallet - wallet for LNURLcash bearer tokens",
  "author": "dni",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lib": "vitest run --config src/lib/vitest.config.ts",
    "test:all": "npm run test && npm run test:lib",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:napplet": "vite build --config vite.napplet.config.mts",
    "preview:napplet": "node scripts/napplet-host.mjs",
    "test:napplet:browser": "playwright test --config playwright.napplet.config.ts",
    "build:notes": "vite build --config vite.napplet.config.mts --mode notes",
    "build:designer": "npm run build:notes",
    "preview:wallet": "node scripts/napplet-host.mjs --app wallet",
    "preview:notes": "node scripts/napplet-host.mjs --app notes"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@napplet/sdk": "0.28.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@solidjs/router": "^1.0.0",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.15",
    "solid-qr-code": "^0.1.11",
    "solid-toast": "^0.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@napplet/shim": "0.28.0",
    "@napplet/vite-plugin": "0.14.1",
    "@playwright/test": "1.63.0",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "solid-icons": "^1.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  }
}
